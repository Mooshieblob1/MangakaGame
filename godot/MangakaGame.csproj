<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>MangakaGame</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/MangakaSim/MangakaSim.csproj" />
    <EmbeddedResource Include="Tools/screenshot_avif.py" LogicalName="MangakaGame.ScreenshotAvif" />
  </ItemGroup>
  <ItemGroup>
    <!-- Steam achievements (Q68): Steamworks.NET with Valve's steam_api64.dll beside the game assemblies. -->
    <Reference Include="Steamworks.NET">
      <HintPath>ThirdParty/Steamworks.NET/Steamworks.NET.dll</HintPath>
    </Reference>
    <None Include="ThirdParty/Steamworks.NET/steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
